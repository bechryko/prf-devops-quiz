    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "mongoose": "^8.14.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "prom-client": "^15.1.3",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3"
